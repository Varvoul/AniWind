{
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/latest-updates",         "destination": "/browse.html" },
    { "source": "/schedule",               "destination": "/schedule.html" },

    { "source": "/browse",                 "destination": "/browse.html" },
    { "source": "/search",                 "destination": "/browse.html" },
    { "source": "/genre/:name",            "destination": "/browse.html" },
    { "source": "/country/:name",          "destination": "/browse.html" },
    { "source": "/type/:name",             "destination": "/browse.html" },
    { "source": "/status/:name",           "destination": "/browse.html" },
    { "source": "/new-releases",           "destination": "/browse.html" },
    { "source": "/recent",                 "destination": "/browse.html" },

    { "source": "/anime/genre/:name",      "destination": "/browse.html" },
    { "source": "/anime/studio/:name",     "destination": "/browse.html" },
    { "source": "/anime/status/:name",     "destination": "/browse.html" },
    { "source": "/anime/season/:name/year/:year", "destination": "/browse.html" },

    { "source": "/tv/genre/:name",         "destination": "/browse.html" },
    { "source": "/tv/studio/:name",        "destination": "/browse.html" },
    { "source": "/tv/status/:name",        "destination": "/browse.html" },

    { "source": "/movie/genre/:name",      "destination": "/browse.html" },
    { "source": "/movie/studio/:name",     "destination": "/browse.html" },
    { "source": "/movie/status/:name",     "destination": "/browse.html" },

    { "source": "/info/anime/:id",         "destination": "/info.html" },
    { "source": "/info/anime/:id/:slug",   "destination": "/info.html" },
    { "source": "/info/movie/:id",         "destination": "/info.html" },
    { "source": "/info/movie/:id/:slug",   "destination": "/info.html" },
    { "source": "/info/tv/:id",            "destination": "/info.html" },
    { "source": "/info/tv/:id/:slug",      "destination": "/info.html" },
    { "source": "/info/:type/:id/:slug/season/:season", "destination": "/info.html" },
    { "source": "info/TV/:id/:slug",        "destination": "/info.html" },

    { "source": "/watch/anime/:id",        "destination": "/watch.html" },
    { "source": "/watch/anime/:id/:slug",  "destination": "/watch.html" },
    { "source": "/watch/anime/:id/:slug/episode/:ep", "destination": "/watch.html" },
    { "source": "/watch/movie/:id",        "destination": "/watch.html" },
    { "source": "/watch/movie/:id/:slug",  "destination": "/watch.html" },
    { "source": "/watch/movie/:id/:slug/season/:season/episode/:ep", "destination": "/watch.html" },
    { "source": "/watch/tv/:id",           "destination": "/watch.html" },
    { "source": "/watch/tv/:id/:slug",     "destination": "/watch.html" },
    { "source": "/watch/tv/:id/:slug/season/:season/episode/:ep", "destination": "/watch.html" },

    { "source": "/jikan/:path*",           "destination": "https://api.jikan.moe/v4/:path*" }
  ],
  "crons": []
}
