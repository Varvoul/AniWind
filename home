            score:(i.vote_average||0).toFixed(1),quality:'HD'
          }))
          .slice(0, TARGET_SHOWS);

        const tmdbMovieItems = allTmdbMovies
          .filter(i => i.poster_path && i.poster_path !== 'null' && i.poster_path !== 'undefined')
          .map(i=>({
            id:`tmdb-movie-comp-${i.id}`,title:i.title,poster:tmdbImg(i.poster_path),
            type:'Movie',year:(i.release_date||'').slice(0,4),
            score:(i.vote_average||0).toFixed(1),quality:'HD'
          }))
          .slice(0, TARGET_SHOWS);

        // Also filter Anilist completed anime without posters
        const anilistItemsFiltered = anilistItems.filter(a =>
          a.poster && a.poster !== '' && a.poster !== 'null' && a.poster !== 'undefined'
        );

        // Interleave in [Anime][TV][Movie] ratio, repeating.
        const interleaved = [];
        const maxLen = Math.max(anilistItemsFiltered.length, tmdbTvItems.length, tmdbMovieItems.length);
        for (let i = 0; i < maxLen; i++) {
          if (i < anilistItemsFiltered.length) interleaved.push(anilistItemsFiltered[i]);
          if (i < tmdbTvItems.length)          interleaved.push(tmdbTvItems[i]);
          if (i < tmdbMovieItems.length)        interleaved.push(tmdbMovieItems[i]);
        }
        // Trim to exactly 6 complete rows (no incomplete last row!)
        const trimTo = Math.min(Math.floor(interleaved.length/cols)*cols, TARGET_SHOWS);
        const list = interleaved.slice(0, trimTo || TARGET_SHOWS);
        document.getElementById('completedGrid').innerHTML = list.map(s => renderCompletedCard(s)).join('');
        renderPagination(page, false);
      }
      function renderPagination(page, isLoading=false) {
        const total = Math.ceil(1000/20);
        const nav = document.getElementById('completedPagination');
        
        // Responsive: Desktop shows 6 pages, Mobile shows 4 pages
        const isMobile = window.innerWidth <= 768;
        const visiblePages = isMobile ? 4 : 6;
        
        let html = `<button ${(page===1||isLoading)?'disabled':''} id="compPrev">Previous</button><div style="display:flex;gap:4px;flex-wrap:wrap;">`;
        
        // Calculate visible range centered on current page
        const halfRange = Math.floor(visiblePages / 2);
        let start = Math.max(1, page - halfRange);
        let end = Math.min(total, start + visiblePages - 1);
        
        // Adjust start if we're near the end
        if (end - start + 1 < visiblePages) {
          start = Math.max(1, end - visiblePages + 1);
        }
        
        for (let i=start; i<=end; i++) {
          html += `<button class="${i===page?'active':''}" data-page="${i}" ${isLoading?'disabled':''}>${i}</button>`;
        }
        html += `</div><button ${(page>=total||isLoading)?'disabled':''} id="compNext">Next</button>`;
        nav.innerHTML = html;
        nav.classList.toggle('pagination-loading', isLoading);
        if (isLoading) return; // buttons are disabled; skip attaching new handlers until data lands
        document.getElementById('compPrev')?.addEventListener('click', ()=>loadCompleted(page-1));
        document.getElementById('compNext')?.addEventListener('click', ()=>loadCompleted(page+1));
        nav.querySelectorAll('button[data-page]').forEach(b => {
          b.addEventListener('click', ()=>loadCompleted(parseInt(b.dataset.page)));
        });
      }

      // Re-fetch when crossing the desktop breakpoint so the row count
      // (6 vs 9) and grid density stay correct after a resize.
      let _completedWasDesktop = window.innerWidth > 1100;
      window.addEventListener('resize', () => {
        const isDesktop = window.innerWidth > 1100;
        if (isDesktop !== _completedWasDesktop) {
          _completedWasDesktop = isDesktop;
          loadCompleted(completedCurrentPage);
        }
      });

