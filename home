          })),
          ...anilistItems
        ].sort((a,b)=>b.score-a.score).slice(0,20);
        trendingData.forEach((item,i)=>item.rank=i+1);
        document.getElementById('trendingList').innerHTML = trendingData.map(s => renderShowCard(s)).join('');
