      border-radius: 0;
      margin-bottom: 0;
    }
    .card-info-grid {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 24px 8px 8px;
      background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 100%);
      border-radius: 0 0 var(--radius-md) var(--radius-md);
      color: #fff;
      pointer-events: none;
    }

    /* Sliding Toggle Tabs with Glider Effect */
    .toggle-tabs {
      display: flex;
      position: relative;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(12px);
      padding: 4px;
      border-radius: var(--radius-pill, 50px);
      border: 1px solid rgba(148, 163, 184, 0.1);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.05);
      gap: 0;
    }
    .toggle-tab {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 32px;
      padding: 0 16px;
      border-radius: var(--radius-pill, 50px);
      font-size: 0.75rem;
      font-weight: 500;
      cursor: pointer;
      transition: color 0.25s ease-in-out;
      position: relative;
      z-index: 2;
      background: transparent;
      border: none;
      color: var(--text-secondary, #94a3b8);
      white-space: nowrap;
    }
    .toggle-tab:hover {
      color: #e2e8f0;
    }
    .toggle-tab.active {
      color: #ffffff;
      font-weight: 600;
    }
    /* Glider/Slider Background */
    .tabs-glider {
      position: absolute;
      height: 32px;
      background: linear-gradient(135deg, var(--btn-primary, #3b82f6), rgba(59, 130, 246, 0.85));
      border-radius: var(--radius-pill, 50px);
      z-index: 1;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 2px 8px rgba(59, 130, 246, 0.35);
    }
    /* Responsive tabs scaling */
    @media (max-width: 768px) {
      .toggle-tabs {
        transform: scale(0.9);
        transform-origin: right center;
      }
      /* Fix: Keep tabs inline with title on mobile - prevent wrapping */
      .section-header:has(.toggle-tabs) {
        flex-wrap: nowrap !important;
        gap: 6px !important;
      }
      .section-header:has(.toggle-tabs) .section-title {
        font-size: 1.1rem !important;
        white-space: nowrap !important;
        flex-shrink: 1 !important;
        min-width: 0 !important;
      }
      .section-header:has(.toggle-tabs) .toggle-tabs {
        flex-shrink: 0 !important;
      }
      /* #releaseTabs opts out of the transform-scale approach below —
         CSS transform: scale() distorts the box that getBoundingClientRect()
         reports, and since the glider is a child of the same scaled element,
         its width/position get scaled a second time. That's what causes the
         glider to land in the wrong spot in mobile portrait. Sizing directly
         via padding/font instead keeps the glider math 1:1 at every width. */
      #releaseTabs.toggle-tabs {
        transform: none !important;
      }
      #releaseTabs .toggle-tab {
        padding: 0 11px;
        font-size: 0.7rem;
        height: 29px;
      }
      #releaseTabs .tabs-glider {
        height: 29px;
      }
    }
    @media (max-width: 480px) {
      .toggle-tabs {
        transform: scale(0.78);
        transform-origin: right center;
      }
      .toggle-tab {
        padding: 0 10px;
        font-size: 0.65rem;
        height: 26px;
      }
      .tabs-glider {
        height: 26px;
      }
      /* Extra compact for very small screens */
      .section-header:has(.toggle-tabs) .section-title {
        font-size: 1rem !important;
      }
      /* Drop icons at the smallest breakpoint — text + count stay legible */
      #releaseTabs .toggle-tab i { display: none; }
      #releaseTabs .toggle-tab { gap: 4px; }
      /* Same reasoning as the 768px override above — keep #releaseTabs
         un-transformed so the glider's rect math stays accurate. */
      #releaseTabs.toggle-tabs { transform: none !important; }
      #releaseTabs .toggle-tab { padding: 0 9px; font-size: 0.62rem; height: 25px; }
      #releaseTabs .tabs-glider { height: 25px; }
    }

