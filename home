      /* ── Shared helper: compute a "visible width minus one card" scroll amount ── */
      function getRowScrollAmount(container) {
        const cardWidth = 165; // Fixed card width
        const gap = 14;
        const containerWidth = container.clientWidth;
        const visibleCols = Math.floor((containerWidth + gap) / (cardWidth + gap));
        return Math.max(1, visibleCols - 1) * (cardWidth + gap);
      }
      /* ── Shared helper: enable PC left/right arrow-key scrolling while hovering a section ── */
      function enableArrowKeyScroll(sectionEl, containerEl) {
        if (!sectionEl || !containerEl) return;
        document.addEventListener('keydown', (e) => {
          if ((e.key === 'ArrowLeft' || e.key === 'ArrowRight') &&
              (sectionEl.matches(':hover') || containerEl.matches(':hover'))) {
            e.preventDefault();
            const amount = getRowScrollAmount(containerEl);
            containerEl.scrollBy({ left: e.key === 'ArrowLeft' ? -amount : amount, behavior: 'smooth' });
          }
        });
      }

      /* ── Popular Anime sidebar: vertical scroll nav (5 rows visible) ──
         Up chevron / ArrowUp = scroll up (bottom-to-top).
         Down chevron / ArrowRight = scroll down (top-to-bottom). */
      function initPopularAnimeScroll() {
        const section   = document.getElementById('popularAnimeSec');
        const container = document.getElementById('popularAnimeList');
        const upBtn      = document.getElementById('popularAnimeUp');
        const downBtn    = document.getElementById('popularAnimeDown');
        if (!section || !container || !upBtn || !downBtn) return;

        const ROWS_PER_PAGE = 7; // matches the 7-row visible viewport
        function rowHeight() {
          const row = container.querySelector('.pa-row');
          const h = row ? row.getBoundingClientRect().height : 88;
          return h + 5; // + gap
        }
        // Move a full page (7 rows) per click/keypress instead of one row at a
