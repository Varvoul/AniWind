<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/png" href="https://i.postimg.cc/BvwTjXgv/image-359e594e.png">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes, viewport-fit=cover">
  <title>Aniocean· Stream Anime, Movies & TV-Show</title>
  <meta name="description" content="Watch the latest anime, movies, and TV series for free on Aniocean. Discover new releases effortlessly with real-time search and multi-language subs.">
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="shared.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:opsz,wght@14..32,400..700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    :root {
      --bg-body: #0a1929;
      --bg-header: #0f2440;
      --bg-card: #132f4c;
      --bg-surface: #1a3a5c;
      --bg-popup: #102a44;
      --text-primary: #ffffff;
      --text-secondary: #b0c7e3;
      --text-muted: #94a3b8;
      --text-widget-title: #a2c4de;
      --btn-primary: #2b6cb0;
      --btn-primary-hover: #1d4e89;
      --btn-primary-text: #ffffff;
      --btn-secondary: #334e68;
      --btn-secondary-hover: #243b53;
      --popup-btn: #5c6ac4;
      --popup-btn-text: #ffffff;
      --popup-btn-hover: #4955b5;
      --genre-tag-bg: #4c51bf;
      --link-accent: #ed64a6;
      --accent-gold: #ecc94b;
      --accent-blue: #4299e1;
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-medium: rgba(255, 255, 255, 0.16);
      --font-title: 'Archivo Black', sans-serif;
      --font-body: 'Inter', sans-serif;
      --font-meta: 'Poppins', sans-serif;
      --radius-sm: 6px;
      --radius-md: 12px;
      --radius-lg: 18px;
      --radius-pill: 50px;
      --radius-circle: 50%;
      --shadow-lg: 0 20px 60px rgba(0,0,0,0.5);
      --transition-fast: 0.18s ease;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      background: var(--bg-body);
      font-family: var(--font-body);
      color: var(--text-primary);
      line-height: 1.5;
      overflow-x: hidden;
      min-height: 100vh;
    }
    a { text-decoration: none; color: inherit; cursor: pointer; }
    img { max-width: 100%; display: block; }
    button, .btn-heart, .btn-watch { cursor: pointer; font-family: inherit; }

    /* ── HERO SLIDER ── */
    .hero-slider {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: #000;
    }
    .slides-container {
      display: flex;
      transition: transform 0.55s ease-in-out;
      height: 100%;
    }
    .slide {
      min-width: 100%;
      height: 100%;
      background-size: cover;
      background-position: center center;
      position: relative;
      display: flex;
      align-items: flex-end;
      padding: 0 5%;
      overflow: hidden;
      animation: kenburns 12s ease-in-out infinite alternate;
      /* Sharpen images for better clarity on desktop */
      image-rendering: -webkit-optimize-contrast;
      image-rendering: crisp-edges;
    }
    /* Special handling for anime poster images - focus on upper portion */
    .slide[data-anime="true"] {
      background-position: center 20%;
    }
    
    /* ════════════════════════════════════════════════════════════
       ANILIST BANNER DISPLAY - Default Size (No Stretch!)
       Anilist banners are ~1000x380px (wide but short)
       Show at natural aspect ratio, no vertical stretching
       ════════════════════════════════════════════════════════════ */
    .slide[data-image-source*="anilist"] {
      background-size: auto 100%;        /* Fit width, maintain aspect ratio */
      background-repeat: no-repeat;
      background-position: center top;   /* Align to top */
      animation: kenburns-banner 14s ease-in-out infinite alternate;
    }
    
    /* Gradient overlay for area below Anilist banner (fills empty space) */
    .slide[data-image-source*="anilist"]::before {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 60%;  /* Cover lower portion where banner doesn't reach */
      background: linear-gradient(
        to top,
        var(--bg-body) 0%,
        rgba(10, 25, 41, 0.95) 30%,
        rgba(10, 25, 41, 0.7) 60%,
        transparent 100%
      );
      z-index: 1;
      pointer-events: none;
    }
    
    /* Subtle Ken Burns effect for banners (horizontal pan only) */
    @keyframes kenburns-banner {
      0%   { background-size: auto 100%; transform: translateX(0); }
      100% { background-size: auto 105%; transform: translateX(-2%); }  /* Gentle right pan */
    }
    
    /* Anime slide enhancement for non-Anilist sources (TMDB/Jikan fallback) */
    .slide-anime:not([data-image-source*="anilist"]) {
      filter: contrast(1.05) saturate(1.1);
    }
    .slide::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background:
        linear-gradient(to top, var(--bg-body) 0%, transparent 22%),
        linear-gradient(to right, rgba(10,25,41,0.55) 0%, rgba(10,25,41,0.15) 45%, rgba(10,25,41,0.55) 100%);
      z-index: 1;
    }
    @keyframes kenburns {
      0%   { background-size: cover; transform: scale(1); }
      100% { background-size: cover; transform: scale(1.05); }
    }
    .slide-content {
      position: relative;
      z-index: 2;
      max-width: 650px;
      width: 100%;
      margin-bottom: 6%;
      background: rgba(15, 36, 64, 0.38);
      backdrop-filter: blur(18px) saturate(140%);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: var(--radius-lg);
      padding: clamp(14px, 2.5vw, 28px);
      box-shadow: var(--shadow-lg);
    }
    .slide-title {
      font-family: var(--font-title);
      font-size: clamp(18px, 4.5vw, 38px);
      margin-bottom: 6px;
      line-height: 1.2;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .slide-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 10px;
      align-items: center;
    }
    .meta-badge {
      background: rgba(255,255,255,0.14);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 4px;
      padding: 2px 6px;
      font-size: clamp(0.55rem, 1.4vw, 0.72rem);
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 3px;
      backdrop-filter: blur(4px);
    }
    .slide-synopsis {
      font-size: clamp(0.55rem, 1.4vw, 0.82rem);
      color: rgba(255,255,255,0.78);
      margin-bottom: 14px;
      line-height: 1.45;
      max-height: 60px;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
    }
    .slide-actions {
      display: flex;
      gap: 10px;
      align-items: center;
    }
    .btn-watch {
      background: var(--btn-primary);
      color: #fff;
      padding: clamp(8px, 1.5vw, 12px) clamp(14px, 2.5vw, 26px);
      border-radius: var(--radius-pill);
      font-weight: 700;
      font-size: clamp(0.7rem, 1.5vw, 0.9rem);
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all var(--transition-fast);
    }
    .btn-watch:hover {
      background: var(--btn-primary-hover);
      transform: scale(1.02);
    }
    .btn-heart-slide {
      width: clamp(32px, 5vw, 44px);
      height: clamp(32px, 5vw, 44px);
      background: rgba(255,255,255,0.08);
      border: 1px solid var(--border-medium);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all var(--transition-fast);
      color: #fff;
      font-size: clamp(0.8rem, 2vw, 1.2rem);
    }
    .btn-heart-slide:hover {
      background: rgba(255,255,255,0.2);
    }
    
    /* ── Card Action Buttons (for sections) ── */
    .card-actions {
      display: flex;
      gap: 8px;
      margin-top: 10px;
      flex-wrap: wrap;
      align-items: center;
    }
    
    .btn-bookmark-slide {
      width: clamp(32px, 5vw, 44px);
      height: clamp(32px, 5vw, 44px);
      background: rgba(255,255,255,0.08);
      border: 1px solid var(--border-medium);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all var(--transition-fast);
      color: #fff;
      font-size: clamp(0.75rem, 1.8vw, 1.1rem);
    }
    .btn-bookmark-slide:hover {
      background: rgba(255,255,255,0.2);
      color: var(--accent-gold);
    }
    
    .btn-details {
      background: transparent;
      color: var(--text-secondary);
      padding: clamp(6px, 1.2vw, 10px) clamp(12px, 2vw, 20px);
      border: 1px solid var(--border-medium);
      border-radius: var(--radius-pill);
      font-weight: 600;
      font-size: clamp(0.65rem, 1.3vw, 0.85rem);
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: all var(--transition-fast);
    }
    .btn-details:hover {
      background: rgba(255,255,255,0.08);
      border-color: var(--btn-primary);
      color: var(--btn-primary);
    }

    /* ── Compact Overlay Actions (for horizontal cards) ── */
    .card-actions-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, transparent 100%);
      padding: 30px 10px 10px;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    
    .show-card-horiz:hover .card-actions-overlay,
    .show-card-grid:hover .card-actions-overlay {
      opacity: 1;
    }
    
    .action-btns-row {
      display: flex;
      gap: 6px;
      justify-content: center;
    }
    
    .action-btn {
      width: 32px;
      height: 32px;
      background: rgba(255,255,255,0.15);
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 0.8rem;
      transition: all 0.2s ease;
    }
    .action-btn:hover {
      background: var(--btn-primary);
      border-color: var(--btn-primary);
      transform: scale(1.1);
    }
    .action-watch:hover { background: #22c55e; border-color: #22c55e; }
    .action-heart:hover { background: #ec4899; border-color: #ec4899; }
    .action-bookmark:hover { background: var(--accent-gold); border-color: var(--accent-gold); }
    .action-details:hover { background: #3b82f6; border-color: #3b82f6; }
    .slider-nav {
      position: absolute;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 14px;
      background: rgba(0,0,0,0.55);
      backdrop-filter: blur(10px);
      border-radius: 30px;
      padding: 4px 16px;
      z-index: 5;
      border: 1px solid var(--border-subtle);
    }
    .slider-arrow {
      background: none;
      border: none;
      color: #fff;
      font-size: clamp(1.2rem, 2.5vw, 1.6rem);
      cursor: pointer;
      padding: 0 2px;
      line-height: 1;
    }
    .slider-arrow:hover {
      color: var(--btn-primary);
    }
    .slide-counter {
      font-size: clamp(0.65rem, 1.5vw, 0.85rem);
      color: rgba(255,255,255,0.85);
    }
    .slider-dots {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      gap: 4px;
      z-index: 5;
    }
    .dot {
      width: clamp(5px, 0.8vw, 7px);
      height: clamp(5px, 0.8vw, 7px);
      background: rgba(255,255,255,0.3);
      border-radius: 50%;
      cursor: pointer;
    }
    .dot.active {
      background: #fff;
      transform: scale(1.3);
    }

    /* ── GRID & CARD ── */
    .card-title {
      font-size: 0.875rem; font-weight:600; color:#fff;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      line-height: 1.3;
    }
    .card-meta-sm { font-size:0.75rem; font-weight:500; color:var(--text-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .card-info-grid .card-title { font-size:0.85rem; }
    .card-info-grid .card-meta-sm { font-size:0.7rem; }
    .badge { font-size:0.625rem; font-weight:700; text-transform:uppercase; }
    /* Status badge - PINK color - TOP LEFT POSITION */
    .poster-status-badge { position:absolute; top:6px; left:6px; background:linear-gradient(135deg, rgba(236,72,153,0.9), rgba(244,114,182,0.9)); color:#fff; font-size:0.6rem; padding:2px 6px; border-radius:3px; z-index:2; font-weight:600; backdrop-filter:blur(4px); }
    
    /* Genre tags on cards */
    .card-genres { display:flex; flex-wrap:wrap; gap:3px; margin-top:4px; }
    .genre-tag { font-size:0.55rem; padding:1px 5px; border-radius:3px; background:rgba(99,102,241,0.18); color:#a5b4fc; border:1px solid rgba(99,102,241,0.25); white-space:nowrap; font-weight:500; }
    .genre-tag:nth-child(n+5) { display:none; } /* Max 4 genres visible */
    .poster-rating-badge { position:absolute; top:6px; right:6px; background:rgba(0,0,0,0.7); color:var(--accent-gold); font-size:0.6rem; padding:2px 5px; border-radius:3px; z-index:2; display:flex; align-items:center; gap:3px; }

    /* ── LAYOUT (scrolls together) ── */
    .main-layout { display:flex; gap:20px; max-width:1920px; margin:0 auto; align-items:flex-start; }
    .main-content { flex:1; min-width:0; padding:0 20px 20px; max-width:calc(100% - 380px); }
    .sidebar-right { flex:0 0 420px; width:420px; padding:0 12px 0 0; position:relative; }
    @media (min-width:1600px) {
      .sidebar-right { flex:0 0 460px; width:460px; }
      .main-content { max-width:calc(100% - 480px); }
    }
    .section { margin:30px 0; }
    .section-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:8px; }
    .section-title { font-family:var(--font-title); font-size:1.35rem; color:var(--text-widget-title); }
    .section-controls { display:flex; align-items:center; gap:8px; }
    .view-all { font-size:0.75rem; font-weight:600; color:var(--link-accent); border:1px solid var(--link-accent); border-radius:var(--radius-pill); padding:5px 12px; white-space:nowrap; transition:all var(--transition-fast); }
    .view-all:hover { background:rgba(237,100,166,0.15); }
    .scroll-arrow { width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.06); border:1px solid var(--border-medium); display:flex; align-items:center; justify-content:center; cursor:pointer; color:#fff; font-size:1rem; }
    .scroll-arrow-disabled, .scroll-arrow:disabled { opacity:0.3; cursor:default; pointer-events:none; }
    .scroll-arrow:hover { background:rgba(255,255,255,0.14); }
    @media (max-width:1024px) { .scroll-arrow { display:none; } }

    .horizontal-scroll { display:flex; gap:14px; overflow-x:auto; scroll-behavior:smooth; padding-bottom:8px; }
    .horizontal-scroll::-webkit-scrollbar { display:none; }
    .show-card-horiz { flex:0 0 auto; width:165px; cursor:pointer; transition:transform var(--transition-fast); }
    .show-card-horiz:hover { transform:translateY(-4px); }
    .card-poster { width:100%; aspect-ratio:3/4.5; background-size:cover; background-position:center; border-radius:var(--radius-md); position:relative; overflow:hidden; margin-bottom:6px; background-color:var(--bg-card); }
    .play-overlay { position:absolute; inset:0; background:rgba(0,0,0,0.5); display:flex; align-items:center; justify-content:center; opacity:0; transition:opacity var(--transition-fast); border-radius:var(--radius-md); }
    .play-overlay svg { width:36px; height:36px; fill:#fff; }
    .show-card-horiz:hover .play-overlay, .show-card-grid:hover .play-overlay { opacity:1; }
    .ranking-badge { position:absolute; top:6px; right:6px; background:rgba(0,0,0,0.6); backdrop-filter:blur(10px); color:#fff; font-weight:700; font-size:0.7rem; padding:2px 7px; border-radius:4px; z-index:2; }
    .quality-badge { position:absolute; top:6px; left:6px; background:rgba(0,0,0,0.7); color:#fff; font-size:0.62rem; padding:2px 5px; border-radius:3px; z-index:2; font-weight:600; }
    .score-badge { position:absolute; top:6px; right:6px; background:rgba(0,0,0,0.7); color:var(--accent-gold); font-size:0.65rem; padding:2px 5px; border-radius:3px; z-index:2; font-weight:600; display:flex; align-items:center; gap:3px; }
    
    /* No Image placeholder - vertically stacked text */
    .card-poster.no-image::before { content:'No'; position:absolute; top:40%; left:50%; transform:translate(-50%,-50%); color:#94a3b8; font-size:0.75rem; font-weight:600; letter-spacing:2px; text-transform:uppercase; z-index:1; user-select:none; }
    .card-poster.no-image::after { content:'Image'; position:absolute; top:55%; left:50%; transform:translate(-50%,-50%); color:#94a3b8; font-size:0.7rem; font-weight:600; letter-spacing:1px; text-transform:uppercase; z-index:1; user-select:none; }

    /* NEW ON ANIOCEAN SECTION - 3-Row Horizontal Scroll Shelf (Netflix-style), computer only */
    .new-aniocean-shelf {
      /* Use CSS Grid for true 3-row horizontal scroll */
      display: grid;
      /* Create 40 columns of 165px each (cards fill left-to-right, top-to-bottom) */
      grid-template-columns: repeat(40, 165px);
      /* Exactly 3 rows (desktop only) */
      grid-template-rows: repeat(3, auto);
      /* CRITICAL: fill column-by-column (row1,row2,row3 triples) instead of the default
         row-by-row flow, which was stacking every card into row 1 only */
      grid-auto-flow: column;
      gap: 12px;
      /* Horizontal scroll only */
      overflow-x: auto;
      overflow-y: hidden;
      scroll-behavior: smooth;
      /* Height for 3 full rows: poster(~248px) + info(~75px) + 2 gaps */
      height: calc(((165px * 4.5 / 3) + 75px) * 3 + 24px);
      max-height: 1000px;
      /* Hide scrollbar like other sections */
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .new-aniocean-shelf::-webkit-scrollbar { display: none; }

    /* Upcoming Shows — desktop-only 2-row grid: row 1 = anime, row 2 = movies+TV.
       Same column-flow pattern as .new-aniocean-shelf but rows are assigned
       explicitly per-card in JS (grid-row 1/2) instead of relying on
       auto-flow, since the two rows hold different content types rather
       than an even split of one list. */
    /* Upcoming section - single interleaved row [TV] [Anime] [Movie] */
    #upcomingScroll {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 12px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-behavior: smooth;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 8px;
    }
    #upcomingScroll::-webkit-scrollbar { display: none; }
    #upcomingScroll .show-card-horiz { 
      flex: 0 0 auto; 
      width: 165px; 
    }
    
    /* Card sizing for grid */
    .new-aniocean-shelf .aniocean-card {
      width: 165px;
      min-width: 165px;
      max-width: 165px;
      /* No flex properties needed - grid controls layout */
    }

    .aniocean-card {
      position: relative;
      cursor: pointer;
      transition: transform var(--transition-fast);
      display: flex;
      flex-direction: column;
    }
    .aniocean-card:hover {
      transform: translateY(-4px);
    }
    .aniocean-poster {
      position: relative;
      aspect-ratio: 3/4.5;
      border-radius: var(--radius-md);
      overflow: hidden;
      background: var(--bg-card);
    }
    .aniocean-poster img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    /* Score Badge - Top Right */
    .aniocean-badge-score {
      position: absolute;
      top: 6px;
      right: 6px;
      background: rgba(0,0,0,0.85);
      backdrop-filter: blur(8px);
      color: var(--accent-gold, #fbbf24);
      padding: 3px 7px;
      border-radius: 4px;
      font-size: 0.72rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 4px;
      z-index: 2;
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }
    .aniocean-badge-score i {
      font-size: 0.65rem;
    }
    
    /* Sub/Dub Badges Container - Bottom Left */
    .aniocean-badge-lang {
      position: absolute;
      bottom: 6px;
      left: 6px;
      display: flex;
      gap: 5px;
      z-index: 2;
    }
    
    /* Individual Language Badge */
    .aniocean-lang-badge {
      padding: 3px 6px;
      border-radius: 4px;
      font-size: 0.62rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 3px;
      backdrop-filter: blur(8px);
      box-shadow: 0 2px 6px rgba(0,0,0,0.25);
      letter-spacing: 0.3px;
    }
    .aniocean-lang-badge i {
      font-size: 0.6rem;
    }
    
    /* Sub Badge - Cyan/Blue theme (matches site accent) */
    .aniocean-lang-badge.sub-badge {
      background: rgba(6, 182, 212, 0.85);
      color: #ffffff;
      border: 1px solid rgba(34, 211, 238, 0.9);
    }
    
    /* Dub Badge - Purple/Violet theme (complementary) */
    .aniocean-lang-badge.dub-badge {
      background: rgba(139, 92, 246, 0.85);
      color: #ffffff;
      border: 1px solid rgba(167, 139, 250, 0.9);
    }
    
