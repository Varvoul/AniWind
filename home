        const slides = $('slidesContainer');
        if (slides) slides.innerHTML = `<div class="skeleton sk-hero" style="border-radius:0;"></div>`;
        // Horizontal scroll sections (cards)
        [['topAiringList',8],['newReleasesList',8],['upcomingList',8],
         ['trendingList',8],['newAnioceanGrid',14],['completedGrid',10]
        ].forEach(([id,n]) => { const el=$(id); if(el) el.innerHTML=`<div style="display:flex;gap:10px;overflow:hidden;">${skCards(n)}</div>`; });
        // Popular Anime list
        const pa = $('popularAnimeList'); if(pa) pa.innerHTML = skPaRows(12);
        // Sidebar (Most Popular)
        const pop = $('popularList'); if(pop) pop.innerHTML = skSideRows(10);
        // Schedule tabs
        document.querySelectorAll('.schedule-day-content,.sched-content,[id^="sched-"]').forEach(el => {
          el.innerHTML = skSchedRows(8);
        });
      }

      // Grid-shaped skeleton used when paginating "Recently Completed" — shows
      // the same column/row layout the real grid will use, so the swap-in
      // feels seamless instead of a layout jump.
