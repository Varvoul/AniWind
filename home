          anilistTrend=await fetchAniList(`query { Page(page:1, perPage:10) { media(type:ANIME, isAdult:false, sort:POPULARITY_DESC) { ${ANILIST_ANIME_FIELDS} } } }`); 
        }
        
        // Convert AniList data
        const anilistItems = [];
        if (anilistTrend?.Page?.media) {
          for (const m of anilistTrend.Page.media) {
            if (!m.isAdult) {
              const internal = anilistToInternal(m);
              anilistItems.push({
                id:`anilist-tr-${m.id}`,
