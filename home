          const filter = tabBtn.dataset.filter;
          currentNewReleasesFilter = filter;
          const grid = document.getElementById('newReleasesGrid');
          const label = tabBtn.dataset.filter === 'all' ? 'All' : tabBtn.dataset.filter === 'anime' ? 'Anime' : tabBtn.dataset.filter === 'movie' ? 'Movies' : 'Series';

