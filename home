  <script>
    (function() {
      /* ── Universal proxy — single CF Worker for all API traffic ── */
      const ANIUMI_PROXY  = 'https://aniumi.bionmovies47.workers.dev';
      /* Direct fallback URLs (used if proxy is unavailable) */
      const JIKAN_BASE    = 'https://api.jikan.moe/v4';
      const TMDB_PROXY    = 'https://t-umi.bionmovies47.workers.dev'; // NEW primary TMDB proxy
      const TMDB_LEGACY   = 'https://aniocen.bionmovies47.workers.dev'; // legacy TMDB proxy (fallback)
      const ANIKOTO_API   = 'https://anikoto.bionmovies47.workers.dev'; // direct anikoto fallback
      const TMDB_IMAGE = 'https://image.tmdb.org/t/p';
      const tmdbImg = (p,s='w500') => p ? `${TMDB_IMAGE}/${s}${p}` : '';
      const tmdbBack = (p) => p ? `${TMDB_IMAGE}/w1280${p}` : '';

      /* ── INFO URL GENERATOR (SEO-Friendly) ──
       * Generates info page URLs with proper format:
       * - Anime: /info/anime/jikan-{mal_id}/slug
       * - TMDB Movie: /info/movie/tmdb-movie-{tmdb_id}/slug
       * - TMDB TV: /info/tv/tmdb-tv-{tmdb_id}/slug-season-{season_number}
       */
      function infoUrl(show, season = 1) {
        const id = show.id;
        const title = (show.title || '').trim();
        const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

        // Anime (Jikan/AniList) → /info/anime/jikan-{mal_id}/slug
        if (id.startsWith('jikan-') || id.startsWith('anilist-') || show.mal_id) {
          const malId = show.mal_id || id.replace(/^jikan-(?:air-|up-|comp-|tr-|pop-|anilist-)?/, '').replace(/^anilist-(?:air-|up-|comp-|tr-|pop-)?/, '');
          const base = `/info/anime/jikan-${malId}`;
          return slug ? `${base}/${slug}` : base;
        }

        // Check explicit type FIRST — avoids id-prefix collisions
        // (e.g. "tmdb-up-tv-123" starting with "tmdb-up-" being
        // misread as a movie id even though show.type === 'TV')
        if (show.type === 'TV' || show.type === 'tv') {
          const numeric = show.tmdb_id || id.replace(/^tmdb-(?:tv|tvpop|comp|uptv|up-tv)-/, '');
          const base = `/info/tv/tmdb-tv-${numeric}`;
          const seasonSuffix = season ? `-season-${season}` : '';
          return slug ? `${base}/${slug}${seasonSuffix}` : base;
        }

        if (show.type === 'Movie' || show.type === 'movie') {
          const numeric = show.tmdb_id || id.replace(/^tmdb-(?:mv|movie|up)-/, '');
          const base = `/info/movie/tmdb-movie-${numeric}`;
          return slug ? `${base}/${slug}` : base;
        }

        // Fallback: id-prefix guessing (only used when show.type is missing)
        if (id.startsWith('tmdb-mv-') || id.startsWith('tmdb-movie-') || id.startsWith('tmdb-up-')) {
          const numeric = show.tmdb_id || id.replace(/^tmdb-(?:mv|movie|up)-/, '');
          const base = `/info/movie/tmdb-movie-${numeric}`;
          return slug ? `${base}/${slug}` : base;
        }

        if (id.startsWith('tmdb-tv-') || id.startsWith('tmdb-tvpop-') || id.startsWith('tmdb-comp-') || id.startsWith('tmdb-uptv-')) {
          const numeric = show.tmdb_id || id.replace(/^tmdb-(?:tv|tvpop|comp|uptv)-/, '');
          const base = `/info/tv/tmdb-tv-${numeric}`;
          const seasonSuffix = season ? `-season-${season}` : '';
          return slug ? `${base}/${slug}${seasonSuffix}` : base;
        }

        // Numeric ID fallback (treat as anime)
        if (/^\d+$/.test(id)) {
          const base = `/info/anime/jikan-${id}`;
          return slug ? `${base}/${slug}` : base;
        }

        // Final fallback
        return `/info/${id}`;
      }

      /* ── WATCH URL GENERATOR (SEO-Friendly) ──
       * Generates watch page URLs with proper format:
       * - Anime: /watch/anime/jikan-{mal_id}/slug/episode/{episode_number}
       * - TMDB Movie: /watch/movie/tmdb-movie-{tmdb_id}/slug
       * - TMDB TV: /watch/tv/tmdb-tv-{tmdb_id}/{slug}/season/{season_number}/episode/{episode_number}
       * 
       * Default: season=1, episode=1 for "Watch Now" button.
       */
      function watchUrl(show, season = 1, episode = 1) {
        const id = show.id;
        const title = (show.title || '').trim();
        const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

        // Anime (Jikan/AniList) → /watch/anime/jikan-{mal_id}/slug/episode/{episode}
        if (id.startsWith('jikan-') || id.startsWith('anilist-') || show.mal_id) {
          const malId = show.mal_id || id.replace(/^jikan-(?:air-|up-|comp-|tr-|pop-|anilist-)?/, '').replace(/^anilist-(?:air-|up-|comp-|tr-|pop-)?/, '');
          const base = `/watch/anime/jikan-${malId}`;
          const slugPart = slug ? `/${slug}` : '';
          return `${base}${slugPart}/episode/${episode}`;
        }

        // Check explicit type FIRST — avoids id-prefix collisions
        if (show.type === 'TV' || show.type === 'tv') {
          const numeric = show.tmdb_id || id.replace(/^tmdb-(?:tv|tvpop|comp|uptv|up-tv)-/, '');
          const base = `/watch/tv/tmdb-tv-${numeric}`;
          const slugPart = slug ? `/${slug}` : '';
          return `${base}${slugPart}/season/${season}/episode/${episode}`;
        }

        if (show.type === 'Movie' || show.type === 'movie') {
          const numeric = show.tmdb_id || id.replace(/^tmdb-(?:mv|movie|up)-/, '');
          const base = `/watch/movie/tmdb-movie-${numeric}`;
          return slug ? `${base}/${slug}` : base;
        }

        // Fallback: id-prefix guessing (only used when show.type is missing)
        if (id.startsWith('tmdb-mv-') || id.startsWith('tmdb-movie-') || id.startsWith('tmdb-up-')) {
          const numeric = show.tmdb_id || id.replace(/^tmdb-(?:mv|movie|up)-/, '');
          const base = `/watch/movie/tmdb-movie-${numeric}`;
          return slug ? `${base}/${slug}` : base;
        }

        if (id.startsWith('tmdb-tv-') || id.startsWith('tmdb-tvpop-') || id.startsWith('tmdb-comp-') || id.startsWith('tmdb-uptv-')) {
          const numeric = show.tmdb_id || id.replace(/^tmdb-(?:tv|tvpop|comp|uptv)-/, '');
          const base = `/watch/tv/tmdb-tv-${numeric}`;
          const slugPart = slug ? `/${slug}` : '';
          return `${base}${slugPart}/season/${season}/episode/${episode}`;
        }

        // Fallback
        return `/watch/${id}`;
      }

      /* ── BUTTON HTML GENERATORS ── */
      function generateCardButtons(show, options = {}) {
        const { 
          showWatch = true, 
          showHeart = true, 
          showBookmark = true,
          showDetails = true,
          compact = false,
          defaultSeason = 1,
          defaultEpisode = 1
        } = options;

        const infoLink = infoUrl(show);
        const watchLink = watchUrl(show, defaultSeason, defaultEpisode);
        
        let buttonsHtml = '';
        
        if (!compact) {
          // Full button row layout
          buttonsHtml = `<div class="card-actions">`;
          
          if (showWatch) {
            buttonsHtml += `<a href="${watchLink}" class="btn-watch" title="Watch Now">
              <i class="fas fa-play"></i> ${options.watchText || 'Watch'}
            </a>`;
          }
          
          if (showHeart) {
            buttonsHtml += `<a href="${infoLink}" class="btn-heart-slide" title="Add to Favorites">
              <i class="far fa-heart"></i>
            </a>`;
          }
          
          if (showBookmark) {
            buttonsHtml += `<a href="${infoLink}" class="btn-bookmark-slide" title="Bookmark">
              <i class="far fa-bookmark"></i>
            </a>`;
          }
          
          if (showDetails) {
            buttonsHtml += `<a href="${infoLink}" class="btn-details" title="View Details">
              <i class="fas fa-info-circle"></i> Details
            </a>`;
          }
          
          buttonsHtml += `</div>`;
        } else {
          // Compact overlay style (for horizontal cards)
          buttonsHtml = `<div class="card-actions-overlay">
            <div class="action-btns-row">`;
            
          if (showWatch) {
            buttonsHtml += `<a href="${watchLink}" class="action-btn action-watch" title="Watch Now">
              <i class="fas fa-play"></i>
            </a>`;
          }
          
          if (showHeart) {
            buttonsHtml += `<a href="${infoLink}" class="action-btn action-heart" title="Favorites">
              <i class="far fa-heart"></i>
            </a>`;
          }
          
          if (showBookmark) {
            buttonsHtml += `<a href="${infoLink}" class="action-btn action-bookmark" title="Bookmark">
              <i class="far fa-bookmark"></i>
            </a>`;
          }
          
          if (showDetails) {
            buttonsHtml += `<a href="${infoLink}" class="action-btn action-details" title="Details">
              <i class="fas fa-info-circle"></i>
            </a>`;
          }
          
          buttonsHtml += `</div></div>`;
        }
        
        return buttonsHtml;
      }

      const GENRE_MAP = {
        28:'Action',12:'Adventure',16:'Animation',35:'Comedy',80:'Crime',99:'Documentary',
        18:'Drama',10751:'Family',14:'Fantasy',36:'History',27:'Horror',10402:'Music',
        9648:'Mystery',10749:'Romance',878:'Science Fiction',10770:'TV Movie',53:'Thriller',
        10752:'War',37:'Western',10759:'Action & Adventure',10762:'Kids',10763:'News',
        10764:'Reality',10765:'Sci-Fi & Fantasy',10766:'Soap',10767:'Talk',10768:'War & Politics'
      };

      const RATING_EXPLAIN = {
        'g':'All Ages','pg':'Children','pg_13':'Teens 13+','r':'17+ (violence & profanity)',
        'r+':'Mild Nudity','rx':'Hentai','none':'Unrated'
      };

      async function fetchAnikoto(endpoint) {
        // 1) Try universal proxy (cached, CORS-safe)
        try {
          const proxyPath = endpoint.startsWith('/') ? endpoint : `/${endpoint}`;
          const res = await fetch(`${ANIUMI_PROXY}/anikoto${proxyPath}`, {
            headers: { Accept: 'application/json' },
            signal: AbortSignal.timeout(8000)
          });
          if (res.ok) {
            const json = await res.json();
            return { ok: true, data: json.data || json };
          }
        } catch(e) { /* proxy down — fall through */ }
        // 2) Direct Anikoto fallback
        try {
          const res = await fetch(`${ANIKOTO_API}${endpoint}`, {
            headers: { Accept: 'application/json' }
          });
          if (!res.ok) return { ok: false, data: [] };
          const json = await res.json();
          return { ok: true, data: json.data || json };
        } catch(e) {
          console.error('Anikoto fetch error:', e);
          return { ok: false, data: [] };
        }
      }

      async function fetchTMDB(endpoint, params='') {
        const qs = params ? `?${params}` : '';
        let lastError = null;
        
        // DETECT if this is a PAGINATED request (has page parameter)
        const requestedPage = new URLSearchParams(params).get('page');
        const isPaginated = requestedPage && parseInt(requestedPage) > 1;
        
        // 1) t-umi proxy — WORKS for page=1, but BROKEN for pagination (caching bug ignores query params)
        //    Skip t-umi entirely for paginated requests to avoid stale cached data!
        if (!isPaginated) {
          try {
            const res = await fetch(`${TMDB_PROXY}${endpoint}${qs}`, {
              headers: { Accept: 'application/json' },
              signal: AbortSignal.timeout(10000)
            });
            if (res.ok) {
