      /* ── POPULAR ANIME (Miruro-style list, sorted by score+popularity+rank) ── */
      async function loadPopularAnime() {
        try {
          
          // Fetch popular anime using AniList (replacing Jikan!)
          const [anilistPop, anilistTop] = await Promise.all([
            fetchAniList(`
              query ($perPage: Int) {
                Page(page: 1, perPage: $perPage) {
                  media(type: ANIME, isAdult: false, sort: [POPULARITY_DESC]) {
                    ${ANILIST_ANIME_FIELDS}
                  }
                }
              }
            `, { perPage: 30 }),
            fetchAniList(`
              query ($perPage: Int) {
                Page(page: 1, perPage: $perPage) {
                  media(type: ANIME, isAdult: false, sort: [SCORE_DESC]) {
                    ${ANILIST_ANIME_FIELDS}
                  }
                }
              }
            `, { perPage: 25 })
          ]);
          
          // Merge and deduplicate
          const allMedia = [
            ...(anilistPop?.Page?.media || []),
            ...(anilistTop?.Page?.media || [])
          ];
          
          const seen = new Set();
          const unique = allMedia.filter(m => {
            if (seen.has(m.id)) return false;
            seen.add(m.id);
            return true;
          });
          
          // Score each anime: weighted combo of AniList score + popularity + trending
          const scored = unique.map(m => {
            const avgScore    = m.averageScore || 0;
            const popBonus    = m.popularity ? Math.min(100000 / m.popularity, 10) : 0;
            const trendBonus  = m.trending ? m.trending * 0.5 : 0;
            return { ...m, _w: avgScore * 0.7 + popBonus + trendBonus };
          });
          scored.sort((a, b) => b._w - a._w);
          const top28 = scored.slice(0, 28);

          const slugify = t => (t||'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');

          const el = document.getElementById('popularAnimeList');
          if (!el) return;

          el.innerHTML = top28.map((m, idx) => {
            const internal = anilistToInternal(m);
            const rank     = idx + 1;
            const rankCls  = rank <= 3 ? ` rank-${rank}` : '';
            const title    = internal.title;
            const slug     = slugify(title);
            // Use mal_id for jikan format: /info/anime/jikan-{mal_id}/slug
            const malId = internal.mal_id || m.idMal || m.id;
            const href     = `/info/anime/jikan-${malId}/${slug}`;
            const poster   = internal.poster;
            const bgImg    = poster;
            const type     = internal.type || 'TV';
            const eps      = String(internal.episodes);
            const score    = internal.score;
            const studio   = internal.studio || '—';
            const genres   = internal.genres?.slice(0,4) || [];

            return `<a href="${href}" class="pa-row${rankCls}" style="--pa-bg:url('${bgImg}')">
              <span class="pa-rank">${rank}</span>
              <img class="pa-poster" src="${poster}" alt="${title.replace(/"/g,'&quot;')}" loading="lazy" onerror="this.style.opacity='0'">
              <div class="pa-info">
                <div class="pa-title">${title}</div>
                <div class="pa-meta">
                  <span class="pa-tag">${type}</span>
                  <span class="pa-tag"><i class="fas fa-play" style="font-size:.5rem"></i> ${eps} eps</span>
                  <span class="pa-score"><i class="fas fa-star"></i> ${score}</span>
                  ${studio !== '—' ? `<span class="pa-tag">${studio}</span>` : ''}
                  ${genres.map(g=>`<span class="pa-tag">${g}</span>`).join('')}
                </div>
              </div>
            </a>`;
          }).join('');
          
          // Save to DB — 5h TTL
        } catch(err) {
          console.warn('[loadPopularAnime] failed:', err);
        }
      }

