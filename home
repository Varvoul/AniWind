      /* Deduplicate anime by mal_id across all sources */
      // ── Global hentai filter for all Jikan data ─────────────────────
      const _HENTAI_GENRE_IDS = new Set([12, 49]); // 12=Hentai, 49=Erotica
      function isHentai(a) {
        if (!a) return false;
        const r = (a.rating || '').toLowerCase();
        if (r.includes('rx') || r.includes('hentai') || r === 'r18') return true;
        const genres = [...(a.genres || []), ...(a.explicit_genres || [])];
        return genres.some(g =>
