      /* ════════════════════════════════════════════════════════════
         SCHEDULE SECTION - REBUILT (Self-hosted Jikan API)
         Features: Parallel fetch, Week nav, 5-month limit, Show More
         ════════════════════════════════════════════════════════════ */
      
      // Configuration
      const JIKAN_SCHEDULE_BASE = 'https://jikan-api-bohb.onrender.com/v4/schedule';
      const DAYS = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
      const DAY_FULL_NAMES = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
      const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      
      let scheduleData = null;           // { monday: [anime], tuesday: [...], ... }
      let currentDay = null;             // 'monday' ... 'sunday'
      let currentWeekOffset = 0;         // weeks from today's week start
      const MAX_WEEK_OFFSET = 20;        // ~5 months limit (20 weeks)
      const VISIBLE_COUNT = 9;           // Show 9 animes per day initially

      // ---------- Helper: Fetch single day from self-hosted Jikan ----------
      async function fetchDayFromJikan(day) {
        try {
          const url = `${JIKAN_SCHEDULE_BASE}/${day}?sfw=true`;
          console.log(`[Schedule] Fetching: ${url}`);
          
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 12000); // 12s timeout
          
          const res = await fetch(url, { 
            signal: controller.signal,
            headers: { 'Accept': 'application/json' }
          });
          
          clearTimeout(timeoutId);
          
          if (!res.ok) {
            throw new Error(`HTTP ${res.status}`);
          }
          
          const data = await res.json();
          const animeList = data.data || [];
          
          console.log(`[Schedule] ✅ ${day}: ${animeList.length} anime`);
          return animeList;
          
        } catch (err) {
          console.warn(`[Schedule] ⚠️ Failed to fetch ${day}:`, err.message);
          return [];
        }
      }

      // ---------- Helper: Fetch ALL 7 days in parallel (rate-limit safe) ----------
      async function fetchAllDaysParallel() {
        console.log('[Schedule] 🚀 Starting parallel fetch of all 7 days...');
        
        // Fetch all 7 days simultaneously (self-hosted API should handle this)
        const results = await Promise.allSettled(
          DAYS.map(day => fetchDayFromJikan(day))
        );
        
        const data = {};
        DAYS.forEach((day, idx) => {
          const result = results[idx];
          data[day] = result.status === 'fulfilled' ? result.value : [];
        });
        
        const totalAnime = Object.values(data).reduce((sum, arr) => sum + arr.length, 0);
        console.log(`[Schedule] ✅ Complete! Total: ${totalAnime} anime across 7 days`);
        
        return data;
      }

      // ---------- Enhanced Episode number calculation ----------
      function getEpisodeNumber(anime) {
        // If finished airing, show total episodes
        if (anime.status === 'Finished Airing') return anime.episodes || '?';
        
        const now = new Date();
        const firstAir = anime.aired?.from ? new Date(anime.aired.from) : null;
        
        // Method 1: Calculate from aired_from date (most reliable)
        if (firstAir && !isNaN(firstAir.getTime())) {
          const diffMs = now - firstAir;
          const daysPassed = Math.floor(diffMs / (24 * 60 * 60 * 1000));
          // Most anime air weekly, so estimate episode from weeks
          // Add grace period of 2 days for airing delays
          let episode = Math.floor((daysPassed + 2) / 7) + 1;
          // Cap at total episodes if known
          if (anime.episodes && episode > anime.episodes) {
            episode = anime.episodes;
          }
          // Don't show negative or zero
          if (episode < 1) episode = 1;
          // Only show if anime has started airing
          if (daysPassed >= -7) return episode;
        }
        
        // Method 2: Fallback to episodes count if available
        if (anime.episodes && anime.episodes > 0) {
          // Check if it's currently airing based on status
          if (anime.status === 'Currently Airing') {
            // Estimate: assume ~12-13 week seasons for ongoing
            const estimatedEp = Math.min(anime.episodes, 13);
            return `${estimatedEp}+`;
          }
          return anime.episodes;
        }
        
        // Method 3: Return TBA if we really can't determine
        return 'TBA';
      }

      // ---------- Render schedule for a given day (from scheduleData) ----------
      function renderScheduleForDay(dayName) {
        const container = document.getElementById('eswBody');
        const animeList = scheduleData?.[dayName] || [];
        
        if (!animeList.length) {
          container.innerHTML = `
            <div style="text-align:center;padding:30px 15px;color:var(--text-muted);">
              <i class="fas fa-calendar-times" style="font-size:2rem;opacity:0.3;margin-bottom:10px;display:block;"></i>
              <div style="font-size:0.85rem;">No episodes scheduled</div>
              <div style="font-size:0.7rem;opacity:0.6;margin-top:4px;">for ${DAY_FULL_NAMES[DAYS.indexOf(dayName)]}</div>
            </div>`;
          return;
        }

        // Sort by broadcast time
        const sorted = [...animeList].sort((a, b) => {
          const timeA = a.broadcast?.time || '99:99';
          const timeB = b.broadcast?.time || '99:99';
          return timeA.localeCompare(timeB);
        });

        // Build rows HTML
        const rowsHtml = sorted.map(anime => {
          const episode = getEpisodeNumber(anime);
          const title = anime.title_english || anime.title || 'Unknown Title';
          const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
          const watchUrl = `/info/anime/jikan-${anime.mal_id}/${slug}`;
          // Use large_image_url from v4 format or fallback to jpg
          const poster = anime.images?.webp?.large_image_url || 
                         anime.images?.jpg?.large_image_url || 
                         anime.images?.jpg?.image_url || '';
          // Enhanced broadcast time handling - Jikan v4 returns STRING format
          // Format: "Mondays at 00:00 (JST)" or "Tuesdays at 18:30 (JST)"
          let broadcastTime = '—';
          const broadcast = anime.broadcast;
          if (typeof broadcast === 'string' && broadcast.trim()) {
            // Parse time from string like "Mondays at 00:00 (JST)"
            const timeMatch = broadcast.match(/(\d{1,2}):(\d{2})/);
            if (timeMatch) {
              const h = parseInt(timeMatch[1]).toString().padStart(2, '0');
              const m = timeMatch[2];
              broadcastTime = `${h}:${m}`;
            } else {
              // No time found, show day abbreviation
              const dayMatch = broadcast.match(/^(\w+)/);
              broadcastTime = dayMatch ? dayMatch[1].slice(0, 3) : '—';
            }
          } else if (broadcast && typeof broadcast === 'object') {
            // Fallback for object format (if API changes)
            if (broadcast.time) {
              const timeMatch = broadcast.time.match(/(\d{1,2}):(\d{2})/);
              if (timeMatch) {
                const h = parseInt(timeMatch[1]).toString().padStart(2, '0');
                const m = timeMatch[2];
                broadcastTime = `${h}:${m}`;
              } else {
                broadcastTime = broadcast.time;
              }
            } else if (broadcast.day) {
              broadcastTime = broadcast.day.slice(0, 3);
            }
          }

          return `
            <a href="${watchUrl}" class="schedule-row">
              <div class="schedule-time">${broadcastTime}</div>
              <div class="schedule-poster">
                <img src="${poster}" alt="${escapeHtml(title)}" loading="lazy" 
                     onerror="this.parentElement.style.background='linear-gradient(135deg,#1e293b,#334155)';this.style.display='none';">
              </div>
              <div class="schedule-title">${escapeHtml(title)}</div>
              <div class="schedule-ep">EP ${episode}</div>
            </a>
          `;
        }).join('');

        // Split into visible (9) and hidden
        const rowsArray = rowsHtml.split('</a>').filter(r => r.trim());
        const visibleRows = rowsArray.slice(0, VISIBLE_COUNT).join('</a>') + (rowsArray.length > VISIBLE_COUNT ? '</a>' : '');
        const hiddenRows = rowsArray.slice(VISIBLE_COUNT).join('</a>');
        const hasMore = rowsArray.length > VISIBLE_COUNT;
        const remainingCount = rowsArray.length - VISIBLE_COUNT;

        container.innerHTML = `
          <div class="schedule-list">
            ${visibleRows}
            ${hasMore ? `<div class="schedule-more-wrapper" style="display:none;">${hiddenRows}</div>` : ''}
            ${hasMore ? `<button type="button" class="schedule-more-btn"><i class="fas fa-chevron-down"></i> Show More (${remainingCount} more)</button>` : ''}
          </div>
        `;

        // Attach enhanced show more handler
        const moreBtn = container.querySelector('.schedule-more-btn');
        if (moreBtn) {
          moreBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();

            const wrapper = container.querySelector('.schedule-more-wrapper');
            if (wrapper) {
              const isHidden = wrapper.style.display === 'none';
              wrapper.style.display = isHidden ? 'block' : 'none';
              
              // Update button state
              if (isHidden) {
                moreBtn.classList.add('expanded');
                moreBtn.innerHTML = '<i class="fas fa-chevron-up"></i> Show Less';
              } else {
                moreBtn.classList.remove('expanded');
                moreBtn.innerHTML = `<i class="fas fa-chevron-down"></i> Show More (${remainingCount} more)`;
              }
            }
          });
        }
      }
        

      // ---------- Build week dates (Mon-Sun) ----------
      function buildWeekDates() {
        const now = new Date();
        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const currentDayOfWeek = today.getDay(); // 0 = Sunday
        let monday = new Date(today);
        const diffToMonday = (currentDayOfWeek === 0 ? -6 : 1 - currentDayOfWeek);
        monday.setDate(today.getDate() + diffToMonday + currentWeekOffset * 7);
        
        const weekDates = [];
        for (let i = 0; i < 7; i++) {
          const date = new Date(monday);
          date.setDate(monday.getDate() + i);
          weekDates.push(date);
        }
        return weekDates;
      }
      
      // ---------- Get week label for navigation ----------
      function getWeekLabel(weekDates) {
        if (!weekDates || !weekDates.length) return 'This Week';
        const firstDate = weekDates[0];
        const lastDate = weekDates[6];
        
        const fmt = (d) => `${MONTHS[d.getMonth()]} ${d.getDate()}`;
        const now = new Date();
        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        
        if (firstDate <= today && lastDate >= today) {
          return 'This Week';
        }
        return `${fmt(firstDate)} – ${fmt(lastDate)}`;
      }

      // ---------- Update day cards (Vertical Design) ----------
      function updateDaySelector() {
        const weekDates = buildWeekDates();
        const today = new Date();
        const todayStr = today.toDateString();
        const container = document.getElementById('eswDaysRow');
        
        // Update week label
        const weekLabelEl = document.getElementById('eswWeekLabel');
        if (weekLabelEl) weekLabelEl.textContent = getWeekLabel(weekDates);
        
        // Update nav buttons state
        const prevBtn = document.getElementById('eswPrev');
        const nextBtn = document.getElementById('eswNext');
        if (prevBtn) prevBtn.disabled = currentWeekOffset <= -MAX_WEEK_OFFSET;
        if (nextBtn) nextBtn.disabled = currentWeekOffset >= MAX_WEEK_OFFSET;
        
        // Render vertical day cards
        container.innerHTML = weekDates.map((date, idx) => {
          const isToday = date.toDateString() === todayStr;
          const dayIndex = date.getDay(); // 0=Sun, 1=Mon, ..., 6=Sat
          const dayKeyIdx = dayIndex === 0 ? 6 : dayIndex - 1; // Convert to Mon=0 index
          const isActive = currentDay === DAYS[dayKeyIdx];
          
          return `
            <div class="esw-day-card ${isToday ? 'today' : ''} ${isActive ? 'active' : ''}" 
                 data-day-index="${idx}" data-day-key="${DAYS[dayKeyIdx]}"
                 title="${DAY_FULL_NAMES[dayKeyIdx]}, ${MONTHS[date.getMonth()]} ${date.getDate()}">
              <span class="esw-dc-month">${MONTHS[date.getMonth()]}</span>
              <span class="esw-dc-day">${date.getDate()}</span>
              <span class="esw-dc-weekday">${DAY_FULL_NAMES[dayKeyIdx].slice(0, 3)}</span>
            </div>
          `;
        }).join('');
        
        // Add click handlers
        container.querySelectorAll('.esw-day-card').forEach(card => {
          card.addEventListener('click', (e) => {
            const dayKey = card.dataset.dayKey;
            if (dayKey) setCurrentDay(dayKey);
          });
        });
      }

      // ---------- Set current day, render ----------
      function setCurrentDay(dayKey) {
        currentDay = dayKey;
        updateDaySelector();
        renderScheduleForDay(currentDay);
      }

      // ---------- Main loader ----------
      async function loadSchedule() {
        // Show a loading indicator immediately so the user never sees
        // "No episodes scheduled" while we're still fetching.
        const loadingHtml = '<div style="text-align:center;padding:30px 10px;color:var(--text-muted);font-size:0.85rem;">'
          + '<div style="display:inline-block;width:24px;height:24px;border:2px solid rgba(255,255,255,.15);'
          + 'border-top-color:var(--btn-primary,#3b82f6);border-radius:50%;'
          + 'animation:schedSpin .8s linear infinite;margin-bottom:10px;"></div>'
          + '<div>Loading schedule…</div></div>';
        // Try to show loading state in the current day's container.
        const body0 = document.getElementById('eswBody');
        if (body0) body0.innerHTML = loadingHtml;

        console.log('[Schedule] 🚀 Fetching all 7 days in parallel...');
        scheduleData = await fetchAllDaysParallel();

        // Expose scheduleData globally for debugging
        window.scheduleData = scheduleData;

        // Determine current day (Monday‑Sunday)
        const now = new Date();
        let dayIndex = now.getDay(); // 0 = Sunday
        if (dayIndex === 0) dayIndex = 7;
        const currentDayKey = DAYS[dayIndex - 1];
        setCurrentDay(currentDayKey);
        updateClock();
        setInterval(updateClock, 1000);
      }

      // Week navigation (with 5-month limit)
      function previousWeek() {
        if (currentWeekOffset > -MAX_WEEK_OFFSET) {
          currentWeekOffset--;
          updateDaySelector();
          setCurrentDay(currentDay);
        }
      }
      function nextWeek() {
        if (currentWeekOffset < MAX_WEEK_OFFSET) {
          currentWeekOffset++;
          updateDaySelector();
          setCurrentDay(currentDay);
        }
      }

      function updateClock() {
  const now = new Date();
  const timeStr = now.toLocaleTimeString('en-US', {
    hour12: true,          // 12‑hour AM/PM format
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    timeZoneName: 'short'
  });
  document.getElementById('eswClockText').textContent = timeStr;
}
      document.getElementById('eswPrev').addEventListener('click', previousWeek);
      document.getElementById('eswNext').addEventListener('click', nextWeek);

      function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/[&<>]/g, function(m) {
          if (m === '&') return '&amp;';
          if (m === '<') return '&lt;';
          if (m === '>') return '&gt;';
          return m;
        });
      }
      

      /* ── SLIDING TAB GLIDER FUNCTIONALITY ── */
      function moveGlider(tabsContainerId, gliderId, activeTab) {
        const glider = document.getElementById(gliderId);
        if (!glider || !activeTab) return;
        
        // Calculate position and width
        const tabRect = activeTab.getBoundingClientRect();
        const tabsContainer = document.getElementById(tabsContainerId);
        const containerRect = tabsContainer.getBoundingClientRect();
        
        // Set glider width and position relative to container
        const leftOffset = tabRect.left - containerRect.left;
        glider.style.width = `${tabRect.width}px`;
        glider.style.transform = `translateX(${leftOffset}px)`;
      }
      
      // Initialize gliders on page load and resize
      function initGliders() {
        // Initialize Release Tabs glider
        const releaseActiveTab = document.querySelector('#releaseTabs .toggle-tab.active');
        if (releaseActiveTab) {
          moveGlider('releaseTabs', 'releaseGlider', releaseActiveTab);
        }
        
        // Initialize Trending Tabs glider
        const trendingActiveTab = document.querySelector('#trendingTabs .toggle-tab.active');
        if (trendingActiveTab) {
          moveGlider('trendingTabs', 'trendingGlider', trendingActiveTab);
        }
      }
      
      // Re-initialize on window resize (with debounce)
      let resizeTimeout;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(initGliders, 100);
      });

      function init() {
        injectSkeletons();
        loadHero();
        loadTopAiring();
        loadNewReleases();
        loadNewAniocean();
        loadUpcoming();
        loadCompleted(1);
        loadTrending('today');
        loadPopular();
        loadPopularAnime();
        loadSchedule();
        // Initialize sliding tab gliders
        initGliders();
      }
      window.addEventListener('DOMContentLoaded', init);
    })();
  </script>
