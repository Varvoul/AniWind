      /* ── Horizontal "All" layout (computer only): row1 = anime, row2 = movie/TV ── */
      const NR_HORIZ_MIN_WIDTH = 1024;
      function nrCalcCols() {
        const w = window.innerWidth;
        if (w > 1800) return 7;
        if (w > 1400) return 6;
        if (w > 1200) return 5;
        return 4; // 1024–1200
      }
      function nrIsHorizontalActive() {
        return currentNewReleasesFilter === 'all' && window.innerWidth > NR_HORIZ_MIN_WIDTH;
      }
      function nrBuildHorizontalList() {
        // Row 1 = anime, Row 2 = TMDB TV, Row 3 = TMDB movies. Interleaving
        // in triples lets grid-auto-flow:column sort them into their rows
        // automatically (item1->row1, item2->row2, item3->row3, item4->row1, ...).
        const animeList = allReleases.anime || [];
        const tvList = allReleases.tv || [];
        const movieList = allReleases.movie || [];
        const n = Math.min(animeList.length, tvList.length, movieList.length);
        const combined = [];
        for (let i = 0; i < n; i++) {
          combined.push(animeList[i], tvList[i], movieList[i]);
        }
        // Append any leftovers from longer lists at the end
        combined.push(...animeList.slice(n), ...tvList.slice(n), ...movieList.slice(n));
        return combined;
      }
      function nrLayoutColumns() {
        const grid = document.getElementById('newReleasesGrid');
        if (!grid || !grid.classList.contains('nr-horizontal')) return;
        const cols = nrCalcCols();
        const gap = 14;
        const containerWidth = grid.clientWidth;
        const colWidth = Math.floor((containerWidth - gap * (cols - 1)) / cols);
        grid.style.setProperty('--nr-col-width', colWidth + 'px');
        grid.dataset.nrCols = cols;
      }
      function nrGetScrollAmount() {
        const grid = document.getElementById('newReleasesGrid');
        return grid ? grid.clientWidth : 0;
      }
      let _nrResizeTimer = null;
      window.addEventListener('resize', () => {
        clearTimeout(_nrResizeTimer);
        _nrResizeTimer = setTimeout(() => {
          const shouldBeHorizontal = nrIsHorizontalActive();
          const grid = document.getElementById('newReleasesGrid');
          if (!grid) return;
          const isHorizontal = grid.classList.contains('nr-horizontal');
          if (shouldBeHorizontal !== isHorizontal) {
            // Crossed the desktop breakpoint or tab changed layout mode — re-render fully
            renderNewReleases(currentNewReleasesFilter);
          } else if (shouldBeHorizontal) {
            nrLayoutColumns();
          }
        }, 200);
      });
      let _nrScrollWired = false;
      function nrWireScrollControls() {
        if (_nrScrollWired) return;
        _nrScrollWired = true;
        const leftBtn = document.getElementById('nrScrollLeft');
        const rightBtn = document.getElementById('nrScrollRight');
        const grid = document.getElementById('newReleasesGrid');
        const section = grid ? grid.closest('.section') : null;
        if (leftBtn) leftBtn.addEventListener('click', () => grid.scrollBy({ left: -nrGetScrollAmount(), behavior: 'smooth' }));
        if (rightBtn) rightBtn.addEventListener('click', () => grid.scrollBy({ left: nrGetScrollAmount(), behavior: 'smooth' }));
        if (section && grid) {
          document.addEventListener('keydown', (e) => {
            if (!grid.classList.contains('nr-horizontal')) return;
            if ((e.key === 'ArrowLeft' || e.key === 'ArrowRight') &&
                (section.matches(':hover') || grid.matches(':hover'))) {
              e.preventDefault();
              grid.scrollBy({ left: e.key === 'ArrowLeft' ? -nrGetScrollAmount() : nrGetScrollAmount(), behavior: 'smooth' });
            }
          });
        }
        // Belt-and-suspenders: recompute column width whenever the container's
        // actual box size changes (sidebar/font/image reflows, not just window resize)
        if (grid && 'ResizeObserver' in window) {
          const ro = new ResizeObserver(() => {
            if (grid.classList.contains('nr-horizontal')) nrLayoutColumns();
          });
          ro.observe(grid);
        }
      }

      function renderNewReleases(filter) {
        const grid = document.getElementById('newReleasesGrid');
        const controls = document.getElementById('nrScrollControls')?.closest('.nr-header-controls');
        const useHorizontal = filter === 'all' && window.innerWidth > NR_HORIZ_MIN_WIDTH;
        const data = useHorizontal ? nrBuildHorizontalList() : (allReleases[filter] || []);

        if (!data.length) {
          grid.classList.remove('nr-horizontal');
          grid.style.removeProperty('--nr-col-width');
          if (controls) controls.classList.remove('nr-horiz-active');
          grid.innerHTML = `<div class="nr-empty-state">
            <i class="fas fa-inbox"></i>
            <span>No ${filter === 'all' ? 'releases' : filter} available right now</span>
          </div>`;
          return;
        }

        grid.classList.toggle('nr-horizontal', useHorizontal);
        if (controls) controls.classList.toggle('nr-horiz-active', useHorizontal);

        grid.innerHTML = data.map((s, idx) => buildReleaseCardHTML(s, { featured: !useHorizontal && idx === 0 })).join('');

        if (useHorizontal) {
          nrLayoutColumns();
          nrWireScrollControls();
          grid.scrollLeft = 0;
        } else {
          grid.style.removeProperty('--nr-col-width');
        }
      }
