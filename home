    }
    /* Large desktop (>1800px): 7 cols × 6 rows = 42 shows */
    @media (max-width:1800px) { .grid-container { grid-template-columns:repeat(7, 1fr); gap:12px; } }
    /* Desktop (1400-1800px): 6 cols × 6 rows = 36 shows */
    @media (max-width:1600px) { .grid-container { grid-template-columns:repeat(6, 1fr); } }
    /* Medium desktop (1200-1400px): 6 cols */
    @media (max-width:1400px) { .grid-container { grid-template-columns:repeat(6, 1fr); } }
    /* Small desktop/large tablet (992-1200px): 5 cols */
    @media (max-width:1200px) { .grid-container { grid-template-columns:repeat(5, 1fr); } }
    /* Tablet (768-992px): 4 cols */
    @media (max-width:992px) { .grid-container { grid-template-columns:repeat(4, 1fr); gap:10px; } }
    /* Tablet portrait (600-768px): 3 cols */
    @media (max-width:768px) { .grid-container { grid-template-columns:repeat(3, 1fr); gap:10px; } }
    /* Mobile landscape (520-600px): 3 cols */
    @media (max-width:600px) and (orientation:landscape) { .grid-container { grid-template-columns:repeat(3, 1fr); } }
    /* Mobile landscape (<520px): 2 cols */
    @media (max-width:520px) and (orientation:landscape) { .grid-container { grid-template-columns:repeat(2, 1fr); } }
    /* Mobile portrait (<520px): 2 cols */
    @media (max-width:520px) and (orientation:portrait) { .grid-container { grid-template-columns:repeat(2, 1fr); } }
    @media (max-width:520px) { .grid-container { grid-template-columns:repeat(2, 1fr); } }
    .show-card-grid { border-radius:var(--radius-md); overflow:hidden; cursor:pointer; transition:transform var(--transition-fast); position:relative; }
    .show-card-grid:hover { transform:translateY(-3px); }
    .show-card-grid .card-poster {
