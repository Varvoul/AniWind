        const periodKey = period === 'today' ? 'day' : period;
        if (_trendingCache[periodKey] && _trendingCache[periodKey].length) {
          trendingData = _trendingCache[periodKey];
          trendingData.forEach((item, i) => item.rank = i + 1);
          const el = document.getElementById('trendingList');
          if (el) el.innerHTML = trendingData.map(s => renderShowCard(s)).join('');
          return;
        }
        
        // Using TMDB + AniList (replacing Jikan)
        let tmdb, anilistTrend;
        
        if(period==='today') { 
          tmdb=await fetchTMDB('/trending/all/day'); 
          anilistTrend=await fetchAniList(`query { Page(page:1, perPage:10) { media(type:ANIME, status:RELEASING, isAdult:false, sort:TRENDING_DESC) { ${ANILIST_ANIME_FIELDS} } } }`); 
