        function pageHeight() { return rowHeight() * ROWS_PER_PAGE; }
        upBtn.addEventListener('click', () => container.scrollBy({ top: -pageHeight(), behavior: 'smooth' }));
        downBtn.addEventListener('click', () => container.scrollBy({ top: pageHeight(), behavior: 'smooth' }));

        document.addEventListener('keydown', (e) => {
