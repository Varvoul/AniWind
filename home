      /* ── POPUP (FIXED) ── */
     window.showPopup = function(e, id) {
  clearTimeout(window.popupTimer);
  const show = [...upcomingShows, ...trendingData, ...popularData].find(s => s.id === id);
  if (!show) return;

  // Check if this is an upcoming show
  const isUpcoming = upcomingShows.some(s => s.id === id);

  let buttonHtml = '';
  if (isUpcoming) {
    // Bookmark button – link to the info page (generates correct URL with slug)
    buttonHtml = `<a class="watch-btn" href="${infoUrl(show)}"><i class="fas fa-bookmark"></i> Bookmark</a>`;
  } else {
    // Regular watch button - use SEO-friendly watchUrl function
    buttonHtml = `<a class="watch-btn" href="${watchUrl(show)}"><i class="fas fa-play"></i> Watch Now</a>`;
  }

  const scoreLabel = show.type === 'Anime' ? 'MAL' : 'TMDB';
  const starIcon = '<i class="fas fa-star" style="color:var(--accent-gold)"></i>';

  // Build duration safely — never produce "undefinedm" or "?"
  const rawDuration = (show.duration && show.duration !== '?' && show.duration !== 'undefined') 
    ? show.duration 
    : (show.episode_run_time?.length ? show.episode_run_time[0] + 'm/ep' : null);
  // Safe year extraction with fallbacks
  let safeYear = show.year || (show.release_date||show.first_air_date||'').slice(0,4) || '';
  if (!safeYear || safeYear === '?') safeYear = show.releaseDate || 'TBA';
  if (safeYear === '?') safeYear = 'TBA';
  const safeCert    = show.certification || (show.type === 'TV' ? 'TV-14' : 'PG-13');
  
  // Studio: filter out "?", "—", and empty values
  const safeStudio = show.studio && show.studio !== '?' && show.studio !== '—' && show.studio !== 'undefined' ? show.studio : null;

  const metaHtml = `
    <span class="meta-pill">${show.type || 'Unknown'}</span>
    <span class="meta-pill">${safeCert}</span>
    <span class="meta-pill">${scoreLabel} ${starIcon} ${show.score || 'N/A'}</span>
    ${rawDuration ? `<span class="meta-pill"><i class="fas fa-clock" style="opacity:.7"></i> ${rawDuration}</span>` : ''}
    ${safeYear && safeYear !== '?' ? `<span class="meta-pill"><i class="fas fa-calendar-alt" style="opacity:.7"></i> ${safeYear}</span>` : ''}
    ${safeStudio ? `<span class="meta-pill">${safeStudio}</span>` : ''}
  `;
  // Map internal type label to the URL path segment used for genre links
  const genreTypeSegment = show.type === 'Anime' ? 'anime' : (show.type === 'Movie' ? 'movie' : 'tv');
  // TMDB sometimes bundles two concepts into one genre string with "&"
  // (e.g. "War & Politics", "Sci-Fi & Fantasy"). Split those into separate,
  // independently-linkable pills rather than encoding the "&" into the URL.
  // Multi-word single genres (e.g. "Science Fiction") use "+" for spaces,
  // and the URL segment itself is always lowercased.
  const genreSlug = g => g.trim().toLowerCase().replace(/\s+/g, '+');
  const genresHtml = (show.genres || [])
    .filter(Boolean)
    .flatMap(g => g.split('&').map(part => part.trim()).filter(Boolean))
    .map(g => `<a href="/${genreTypeSegment}/genre/${genreSlug(g)}" class="genre-pill">${g}</a>`)
    .join('');

  const synopsis = show.synopsis || show.overview || 'No description available.';

  document.getElementById('popupContent').innerHTML = `
    <div class="modal-poster-wrap">${show.poster ? `<img src="${show.poster}" alt="${show.title}">` : ''}</div>
    <div class="modal-title">${show.title || ''}</div>
    <div class="modal-subtitle">${show.original_title || show.title || ''}</div>
    <div class="meta-pills-row">${metaHtml}</div>
    <div class="genre-pills-row">${genresHtml}</div>
    ${buttonHtml}
    <div class="modal-synopsis">${synopsis}</div>
  `;

  document.getElementById('popupCard').classList.add('active');
  document.getElementById('popupOverlay').style.pointerEvents = 'auto';
};
