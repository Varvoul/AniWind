      /* ── NEW ON ANIUMI - 2-Row Horizontal Scroll ── */
      (function initNewAnioceanScroll() {
        const container = document.getElementById('newAnioceanGrid');
        const leftBtn = document.getElementById('newAnioceanLeft');
        const rightBtn = document.getElementById('newAnioceanRight');
        if (!container || !leftBtn || !rightBtn) return;
        
        // Calculate how many columns are visible and scroll by that amount
        function getScrollAmount() {
          const cardWidth = 165; // Fixed card width
          const gap = 12;
          const containerWidth = container.clientWidth;
          // Number of visible columns
          const visibleCols = Math.floor((containerWidth + gap) / (cardWidth + gap));
          // Scroll by visible columns minus 1 (to show overlap for context)
          return Math.max(1, visibleCols - 1) * (cardWidth + gap);
        }

        // Once the last column is fully, clearly visible there's nothing
        // left to scroll to — disable the right chevron and the right
        // arrow key so the user isn't invited to keep scrolling nowhere.
        // A small buffer accounts for sub-pixel rounding on some browsers.
        function isAtEnd() {
          return container.scrollLeft + container.clientWidth >= container.scrollWidth - 2;
        }
        function updateEndState() {
          const atEnd = isAtEnd();
          rightBtn.disabled = atEnd;
          rightBtn.classList.toggle('scroll-arrow-disabled', atEnd);
        }
        updateEndState();
        container.addEventListener('scroll', updateEndState);
        window.addEventListener('resize', updateEndState);
        // New data lands after an async fetch — re-check once it's rendered.
        new MutationObserver(updateEndState).observe(container, { childList: true });
        
        leftBtn.addEventListener('click', () => {
          container.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
        });
        rightBtn.addEventListener('click', () => {
          if (isAtEnd()) return;
          container.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
        });
        
        // Keyboard arrow key support when hovering over section
        const section = document.getElementById('newOnAniumiSection');
        if (section) {
          document.addEventListener('keydown', (e) => {
            if ((e.key === 'ArrowLeft' || e.key === 'ArrowRight') && 
                (section.matches(':hover') || container.matches(':hover'))) {
              if (e.key === 'ArrowRight' && isAtEnd()) return; // no more to scroll — let the key do nothing
              e.preventDefault();
              if (e.key === 'ArrowLeft') {
                container.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
              } else {
                container.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
              }
            }
          });
        }
      })();

